{
  "name": "crystal-ball-approvals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:server && node dist/server/index.js",
    "build": "npm run build:server && next build --webpack",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:server": "jest --runInBand",
    "test:ui": "vitest run --configLoader native",
    "test": "npm run test:server && npm run test:ui",
    "test:e2e": "playwright test",
    "build:server": "tsc -p tsconfig.server.json",
    "format": "prettier --write app components contracts data prompts server tests *.json *.ts *.cjs",
    "format:check": "prettier --check app components contracts data prompts server tests *.json *.ts *.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "next": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "cross-env": "^10.0.0",
    "jest": "^30.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
